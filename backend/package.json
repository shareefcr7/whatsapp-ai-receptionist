{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "migrate": "node --env-file-if-exists=.env src/database/migrate.ts",
    "migrate:prod": "node --env-file-if-exists=.env dist/database/migrate.js",
    "staff:create": "node --env-file-if-exists=.env src/database/create-staff.ts",
    "staff:create:prod": "node --env-file-if-exists=.env dist/database/create-staff.js",
    "staff:reset-password": "node --env-file-if-exists=.env src/database/create-staff.ts --reset",
    "staff:reset-password:prod": "node --env-file-if-exists=.env dist/database/create-staff.js --reset",
    "ai:check": "node --env-file-if-exists=.env src/services/ai/check.ts",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "pg-connection-string": "^2.14.1",
    "typescript": "^7.0.2"
  }
}
