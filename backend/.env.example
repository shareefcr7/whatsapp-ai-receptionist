# Copy to backend/.env. Never commit real values.

PORT=4000
NODE_ENV=development
# Comma-separated list of allowed dashboard origins. Required in production.
FRONTEND_URL=http://localhost:5173
# Shared with the dashboard's Vercel proxy (BACKEND_PROXY_SECRET there): at least 32 printable characters, no spaces.
# Required in production. Blank in local development: requests are then accepted without the proxy.
VERCEL_PROXY_SECRET=
# Optional in development, required in production.
# Example format: postgresql://USER:PASSWORD@localhost:5432/whatsapp_receptionist
DATABASE_URL=

# AI provider for replies: "anthropic" (Claude) or "openai". Blank = openai. Only the selected provider's key is used.
# Check the selected key and model with: npm run ai:check
AI_PROVIDER=anthropic
# Anthropic Claude (AI_PROVIDER=anthropic). Blank ANTHROPIC_MODEL = claude-sonnet-5-5.
# Use a current model ID: retired ones such as claude-3-5-sonnet-20241022 fail, and every reply then goes to staff.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# OpenAI (AI_PROVIDER=openai or blank).
OPENAI_API_KEY=
# Optional. Defaults to gpt-4.1-mini (cheap, fast, good for support chat).
OPENAI_MODEL=
# "true" lets the AI answer incoming WhatsApp text messages (paid AI + WhatsApp calls). Blank or "false" = off.
AI_AUTO_REPLY_ENABLED=
# Cost caps on AI calls (both providers together) in any rolling 24 hours. Blank = defaults (200 total, 20 per customer); 0 stops AI replies.
# When a cap is hit the conversation goes to staff instead.
AI_DAILY_REPLY_LIMIT=
AI_CUSTOMER_DAILY_REPLY_LIMIT=
# Messages older than this (Meta's timestamp, e.g. delivered late after an outage) go to staff, not the AI. Blank = 15.
AI_MAX_MESSAGE_AGE_MINUTES=
# Optional. Longest any single database statement may run, in milliseconds (5000-600000). Blank = 30000.
# Migrations are exempt. Must be at least 5000: conversation lock waits use a 3s limit of their own.
# Sent as a connection startup parameter. Behind a connection pooler such as PgBouncer, allow statement_timeout as a
# startup parameter there, or connections fail (or, if the pooler ignores it, the limit silently does not apply).
DB_STATEMENT_TIMEOUT_MS=

# --- Future integrations: blank is allowed, nothing calls these services yet ---

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
# App Dashboard > App settings > Basic. Verifies the X-Hub-Signature-256 on incoming webhooks.
WHATSAPP_APP_SECRET=

# Google Calendar OAuth (Web application client). The redirect URI must match Google Cloud Console exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/integrations/google/callback
# Optional. Defaults to primary (the connected account's main calendar).
GOOGLE_CALENDAR_ID=
# Encrypts Google tokens in PostgreSQL. Generate with: openssl rand -base64 32
# Changing it makes stored tokens unreadable, and the calendar must be reconnected.
GOOGLE_TOKEN_ENCRYPTION_KEY=
